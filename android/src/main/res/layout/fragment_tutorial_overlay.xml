<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.emojigame.core.ui.Theme"/>
        <variable name="theme" type="com.emojigame.core.ui.Theme"/>
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Inner content with margins to create spacing from screen edges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="24dp"
            android:background="@android:color/white"
            android:elevation="6dp"
            android:clipToPadding="false"
            android:clipChildren="false">

            <!-- Puzzle area (2/3 of screen height) -->
            <FrameLayout
                android:id="@+id/puzzle_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <!-- Input area (1/3 of screen height) -->
            <FrameLayout
                android:id="@+id/input_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Transparent tutorial canvas that overlays everything -->
        <com.emojigame.android.ui.views.TutorialCanvasView
            android:id="@+id/tutorial_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:translationZ="9dp"
            android:layout_margin="24dp"
            android:background="@android:color/transparent" />

        <!-- Close button in top-right corner -->
        <ImageView
            android:id="@+id/close_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="24dp"
            android:background="@android:color/white"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:translationZ="10dp" />

        <!-- Reset button next to the close button -->
        <ImageView
            android:id="@+id/reset_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="80dp"
            android:background="@android:color/white"
            android:contentDescription="@string/reset_tutorial"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:translationZ="10dp" />

    </FrameLayout>
</layout>
