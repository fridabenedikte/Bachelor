<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.emojigame.core.ui.Theme" />
        <variable name="theme" type="com.emojigame.core.ui.Theme" />
    </data>

    <LinearLayout
        android:id="@+id/input_fragment_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="@{theme.inputBackgroundColor}"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="0dp" >

        <!-- If-Else Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/if_else_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" >

            <!-- If Block (Left Half) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/if_block"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/else_block"
                app:layout_constraintHorizontal_weight="1">

                <ImageView
                    android:id="@+id/if_image"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/traffic_light_green"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/if_colon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.45"/>

                <TextView
                    android:id="@+id/if_colon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="18sp"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/if_image"
                    app:layout_constraintEnd_toStartOf="@id/if_emoji_slot_container"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <FrameLayout
                    android:id="@+id/if_emoji_slot_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@{theme.backgroundColor}"
                    app:layout_constraintStart_toEndOf="@id/if_colon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <ImageView
                        android:id="@+id/if_emoji_slot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/music_off" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Else Block (Right Half) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/else_block"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/if_block"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1">

                <ImageView
                    android:id="@+id/else_image"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/traffic_light_red"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/else_colon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.45"/>

                <TextView
                    android:id="@+id/else_colon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textSize="18sp"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/else_image"
                    app:layout_constraintEnd_toStartOf="@id/else_emoji_slot_container"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <FrameLayout
                    android:id="@+id/else_emoji_slot_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@{theme.backgroundColor}"
                    app:layout_constraintStart_toEndOf="@id/else_colon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <ImageView
                        android:id="@+id/else_emoji_slot"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/music_off" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Library bar -->
        <include
            layout="@layout/include_library_bar"
            android:id="@+id/library_bar_inclusion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

        <!-- Play button -->
        <include
            layout="@layout/include_play_button"
            android:id="@+id/play_button_inclusion" />
    </LinearLayout>
</layout>
